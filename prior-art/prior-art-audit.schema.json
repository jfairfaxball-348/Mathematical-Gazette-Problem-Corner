{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage-4 Prior-Art Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "audit_started_on",
    "visible_form_searches",
    "equivalence_model",
    "equivalent_form_searches",
    "source_classes",
    "findings",
    "coverage_assessment",
    "final_classification",
    "classification_rationale"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "audit_started_on": {"type": "string"},
    "audit_completed_on": {"type": ["string", "null"]},
    "visible_form_searches": {
      "type": "array",
      "items": {"$ref": "#/$defs/search"}
    },
    "equivalence_model": {
      "type": "object",
      "required": ["story_stripped_kernel", "transformations_checked", "invariants_or_signature"],
      "properties": {
        "story_stripped_kernel": {"type": "string"},
        "transformations_checked": {"type": "array", "items": {"type": "string"}},
        "invariants_or_signature": {"type": "array", "items": {"type": "string"}},
        "equivalence_notes": {"type": "string"}
      }
    },
    "equivalent_form_searches": {
      "type": "array",
      "items": {"$ref": "#/$defs/search"}
    },
    "source_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "searched", "notes"],
        "properties": {
          "class": {"type": "string"},
          "searched": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "relationship", "materiality", "notes"],
        "properties": {
          "source": {"type": "string"},
          "url_or_citation": {"type": ["string", "null"]},
          "relationship": {"type": "string"},
          "materiality": {"enum": ["none", "weak", "related", "material", "near_identical", "identical"]},
          "notes": {"type": "string"}
        }
      }
    },
    "coverage_assessment": {
      "type": "object",
      "required": ["strength", "gaps", "why_reasonably_strong_or_not"],
      "properties": {
        "strength": {"enum": ["weak", "moderate", "reasonably_strong", "strong"]},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "why_reasonably_strong_or_not": {"type": "string"}
      }
    },
    "final_classification": {
      "enum": [
        "CLEAR",
        "CLEAR_WITH_RELATED_PRIOR_ART",
        "MATERIAL_PRIOR_ART_POSSIBLY_SALVAGEABLE",
        "REDISCOVERY",
        "TOO_CLOSE_TO_EXISTING_PROBLEM",
        "NOVELTY_UNCERTAIN"
      ]
    },
    "classification_rationale": {"type": "string"},
    "follow_up_required": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "search": {
      "type": "object",
      "required": ["searched_on", "source_or_engine", "query", "result_summary"],
      "properties": {
        "searched_on": {"type": "string"},
        "source_or_engine": {"type": "string"},
        "query": {"type": "string"},
        "filters_or_scope": {"type": ["string", "null"]},
        "result_summary": {"type": "string"},
        "promising_hits": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
